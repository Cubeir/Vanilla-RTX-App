<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="Vanilla_RTX_App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Vanilla_RTX_App">
    <Application.Resources>
        <ResourceDictionary>
            
            
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="{ThemeResource ContentControlThemeFontFamily}" />
            </Style>
            <Style TargetType="FontIcon">
                <Setter Property="FontFamily"
                        Value="{ThemeResource SymbolThemeFontFamily}" />
            </Style>
            <Style x:Key="TextBlockSegIcons"
                   TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="{ThemeResource SymbolThemeFontFamily}" />
            </Style>
            <Style x:Key="ButtonSegIcons"
                   TargetType="Button">
                <Setter Property="FontFamily"
                        Value="{ThemeResource SymbolThemeFontFamily}" />
            </Style>

            <!-- ══ Colours for elements built in code ════════════════════════════
                 A brush read from code with Application.Current.Resources[...] resolves against
                 Windows' theme, not the app's (which is set on MainWindow's root element), and is
                 never re-resolved afterwards - so on Light-over-a-dark-Windows it paints dark. A
                 code-built element that needs a theme colour takes one of these styles instead:
                 their setters are ThemeResources, resolved for the element's own theme and
                 re-resolved whenever it changes. Text runs cannot take a style; see
                 ThemeService.AccentTextBrush for those. -->
            <Style x:Key="ThemedDividerRuleStyle"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="ThemedAccentEdgeStyle"
                   TargetType="Border">
                <Setter Property="BorderBrush"
                        Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="ThemedCardStyle"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush"
                        Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="ThemedCardOutlineStyle"
                   TargetType="Border">
                <Setter Property="BorderBrush"
                        Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="ThemedSecondaryTextStyle"
                   TargetType="TextBlock">
                <Setter Property="Foreground"
                        Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- The button-coloured fill under a code-built fake-split seam; the XAML ones set
                 the same ThemeResource on their Rectangle directly. -->
            <Style x:Key="ThemedSeamFillStyle"
                   TargetType="Rectangle">
                <Setter Property="Fill"
                        Value="{ThemeResource ButtonBackgroundThemeBrush}" />
            </Style>

            <ResourceDictionary.ThemeDictionaries>

                <!-- Dark theme -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="FakeSplitButtonDarkBorderColor">#3A454545</Color>
                    <Color x:Key="FakeSplitButtonBrightBorderColor">#4A6E6E6E</Color>
                    <Visibility x:Key="LightThemeBackgroundVisibility">Collapsed</Visibility>
                    <SolidColorBrush x:Key="IntersectionNeutralizerBrush"
                                     Color="#15000000" />

                    <Color x:Key="OverlayBackgroundColor">#C0202020</Color>
                    <SolidColorBrush x:Key="OverlayTextBrush"
                                     Color="#FFFFFFFF" />
                    <x:Double x:Key="AlchitexBackdropStaticColorOpacity">0.05</x:Double>

                </ResourceDictionary>

                <!-- Light theme -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="FakeSplitButtonDarkBorderColor">#7AFAFAFA</Color>
                    <Color x:Key="FakeSplitButtonBrightBorderColor">#FBFBFBFB</Color>
                    <Visibility x:Key="LightThemeBackgroundVisibility">Visible</Visibility>
                    <SolidColorBrush x:Key="IntersectionNeutralizerBrush"
                                     Color="#FFFFFFFF" />

                    <Color x:Key="OverlayBackgroundColor">#C0F0F0F0</Color>
                    <SolidColorBrush x:Key="OverlayTextBrush"
                                     Color="#FF000000" />
                    <x:Double x:Key="TintLuminosityOpacity">0.5</x:Double>
                    <x:Double x:Key="AlchitexBackdropStaticColorOpacity">0.75</x:Double>

                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
            
            
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
