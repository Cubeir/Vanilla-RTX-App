<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Vanilla_RTX_App.Modules.Alchitex.Alchitex"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Vanilla_RTX_App.Modules.Alchitex"
        Title="RTX Reactor">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <!--  BACKGROUND IMAGE  -->
        <Image x:Name="AlchitexBackground"
               Source="ms-appx:///Modules/Alchitex/Assets/huge_background.png"
               Stretch="None"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               IsHitTestVisible="False"
               CacheMode="BitmapCache"
               Canvas.ZIndex="-2"
               Opacity="1.0">
        </Image>

        <!-- Light theme tint overlay -->
        <Border x:Name="LightThemeOverlay"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                Visibility="{ThemeResource LightThemeBackgroundVisibility}"
                Canvas.ZIndex="-1">
            <Border.Background>
                <SolidColorBrush Color="#17373737" />
            </Border.Background>
        </Border>

        <!-- TITLEBAR -->
        <Grid x:Name="TitleBarHost"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Canvas.ZIndex="100">

            <!-- Titlebar Background -->
            <Border x:Name="TitleBarBackground"
                    Height="38"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorSecondary}"
                    BorderBrush="{ThemeResource HyperlinkButtonBorderThemeBrush}"
                    BorderThickness="0,0,0,6"
                    CornerRadius="0"
                    Translation="0,0,256"
                    IsHitTestVisible="False">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
            </Border>

            <!-- Drag area  -->
            <Border x:Name="TitleBarDragArea"
                    HorizontalAlignment="Stretch"
                    Height="32"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Background="Transparent"
                    IsHitTestVisible="False" />

            <!-- ══ TITLEBAR ACTIONS - post-license ═════════════════════════════════
                 One of the two containers that make up the post-license UI (the other is
                 MainGrid). Everything in here is hidden until the license is accepted, and
                 children inherit that, so a new titlebar control added inside this Border
                 needs NO code in ShowMainContent - just drop it in.
                 ═══════════════════════════════════════════════════════════════════ -->
            <Border x:Name="TitleBarActions"
                    Margin="-1,-1,16,0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Height="34"
                    Width="Auto"
                    Visibility="Collapsed">
                <Grid Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!-- Always-present buttons -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Debug-only group -->
                    </Grid.ColumnDefinitions>

                    <!-- Info Button -->
                    <Button x:Name="InfoButton"
                            Grid.Column="0"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Content="&#xE946;"
                            Width="40"
                            Height="35"
                            CornerRadius="0"
                            FontSize="16"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="InfoButton_Click"
                            ToolTipService.ToolTip="Learn more..."
                            IsTextScaleFactorEnabled="False" />

                    <!-- Debug builds only. Same idea one level down: dev-only titlebar
                         controls go inside this group and the single #if DEBUG line in
                         ShowMainContent already covers them. -->
                    <StackPanel x:Name="DevOnlyTitleBarActions"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Visibility="Collapsed">

                        <!-- Separator -->
                        <Border Width="1"
                                Margin="4,6,4,6"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Bootstrap materials.json from an already-PBR'd pack. -->
                        <Button x:Name="GenerateMaterialsConfigButton"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Content="&#xEC7A;"
                                Width="40"
                                Height="35"
                                CornerRadius="0"
                                FontSize="16"
                                Click="GenerateMaterialsConfigButton_Click"
                                ToolTipService.ToolTip="DEVELOPER TOOL FOR APPENDING OR GENERATING A BOOTSTRAP FOR MATERIALS.JSON FILE FROM AN EXISTING PBR TEXTURE PACK."
                                IsTextScaleFactorEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ══ Titlebar Content ═════════════════════════════════════════════
                 No logo here on purpose: the Generate button IS the RTX Reactor logo,
                 at full size, and two of the same mark in one window reads badly.

                 This text doubles as the generation status line - SetStatus() in the
                 code-behind writes progress here ("[1/3] SomePack: Generating PBR
                 textures...") and it reverts to "RTX Reactor" once a run is over. That's
                 why there's no status TextBlock down in the content area any more.
                 ═══════════════════════════════════════════════════════════════════ -->
            <Grid x:Name="TitleBarCenterContent"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="48,-7,48,0">

                <TextBlock x:Name="TitleBarText"
                           Text="License Agreement"
                           FontSize="14"
                           Margin="0,7,0,4"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           FontWeight="Normal"
                           IsTextScaleFactorEnabled="False"
                           IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  LOADING PANEL                                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="LoadingPanel"
              Visibility="Visible"
              Margin="0,35,0,0"
              Background="Transparent">
            <ProgressRing IsActive="True"
                          Width="100"
                          Height="100"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  LICENSE PANEL                                          -->
        <!--  Sits BELOW the shared titlebar (Margin top = 35)       -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="LicensePanel"
              Visibility="Collapsed"
              Background="{ThemeResource OverlayBackgroundColor}"
              Padding="16, 0, 16 16"
              Margin="0,36,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- license text  -->
                <RowDefinition Height="Auto" />
                <!-- buttons       -->
            </Grid.RowDefinitions>
            
            <!-- ── License RichTextBlock ── -->
            <ScrollViewer Grid.Row="0"
                          Background="{ThemeResource OverlayBackgroundColor}"
                          Margin="64,32,64,32"
                          MaxWidth="720"
                          BorderBrush="#40FFFFFF"
                          BorderThickness="2"
                          CornerRadius="12"
                          VerticalScrollBarVisibility="Auto">
                <RichTextBlock x:Name="LicenseTextBlock"
                               IsTextSelectionEnabled="False"
                               Padding="24"
                               TextWrapping="Wrap"
                               IsTabStop="False"
                               FontSize="14"
                               LineHeight="20"
                               IsTextScaleFactorEnabled="False"
                               HorizontalAlignment="Center"
                               Translation="0,0,32">
                    <RichTextBlock.Shadow>
                        <ThemeShadow x:Name="LicenseTextShadow" />
                    </RichTextBlock.Shadow>
                    <!-- Populated in code-behind -->
                </RichTextBlock>
            </ScrollViewer>

            <!-- ── Action buttons ── -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="16"
                        Background="Transparent"
                        Margin="0,0,0,24">

                <Button x:Name="DisagreeButton"
                        Padding="16,16,16,16"
                        IsTextScaleFactorEnabled="False"
                        Translation="0,0,32"
                        Click="DisagreeButton_Click"
                        Content="Disagree and close"
                        Style="{ThemeResource ButtonRevealStyle}">
                    <Button.Shadow>
                        <ThemeShadow x:Name="DisagreeShadow" />
                    </Button.Shadow>

                </Button>

                <Button x:Name="AgreeButton"
                        Padding="16,16,16,16"
                        Style="{ThemeResource AccentButtonStyle}"
                        IsTextScaleFactorEnabled="False"
                        Translation="0,0,32"
                        Content="I have read and agreed to the terms and conditions of this feature"
                        Click="AgreeButton_Click">
                    <Button.Shadow>
                        <ThemeShadow x:Name="AgreeShadow" />
                    </Button.Shadow>
                </Button>

            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  MAIN CONTENT GRID - post-license                                   -->
        <!--                                                                     -->
        <!--  The second of the two post-license containers (TitleBarActions up  -->
        <!--  in the titlebar is the other). Everything the user sees after      -->
        <!--  accepting the license lives in one of those two, and children       -->
        <!--  inherit the container's visibility - so adding a control here needs -->
        <!--  no matching line in ShowMainContent. Don't collapse new controls    -->
        <!--  individually unless they're meant to stay hidden for some OTHER     -->
        <!--  reason (AbortButton, the progress bar and status text do that -     -->
        <!--  they're driven by generation state, not by license state).          -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="MainGrid"
              Visibility="Collapsed"
              Background="Transparent"
              Margin="0,37,0,0">

            <!-- ══ ONE SCROLLER FOR THE WHOLE WINDOW ════════════════════════════
                 The controls area is a fixed 512px tall and never scales with the
                 window; the announcements below it are whatever height their cards
                 add up to. Together they overflow the window once there are enough
                 PSAs, and that is what the scrollbar is for - there's no second,
                 nested scroller inside the announcements panel any more.

                 AnnouncementBackground.MinHeight is kept in sync with the leftover
                 viewport height in code-behind (SyncAnnouncementMinHeight), so with
                 only a card or two the acrylic panel still reaches the bottom edge
                 instead of leaving the window background showing under it.
                 ═══════════════════════════════════════════════════════════════ -->
            <ScrollViewer x:Name="MainScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          SizeChanged="MainScrollViewer_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Alchitex controls - fixed height -->
                        <RowDefinition Height="Auto" />
                        <!-- progress bar, doubling as the divider -->
                        <RowDefinition Height="Auto" />
                        <!-- announcements -->
                    </Grid.RowDefinitions>

                    <!-- ══ ALCHITEX CONTROLS ════════════════════════════════════
                         Fixed 512px including its own margins, so the panel inside
                         is a predictable size no matter how tall the window gets -
                         everything that grows lives below this.

                         Three areas, left to right: options, the queued packs'
                         icons, and the giant Generate button. The first two sit on
                         one acrylic panel (same material as the announcements
                         below); the button sits flush against its right edge with
                         the window background behind it, so it reads as its own
                         object rather than another card.
                         ═════════════════════════════════════════════════════ -->
                    <Grid x:Name="AlchitexControlsArea"
                          Grid.Row="0"
                          Height="340"
                          Translation="0,0,64"
                          SizeChanged="AlchitexControlsArea_SizeChanged">
                        <Grid.Shadow>
                            <ThemeShadow />
                        </Grid.Shadow>
                        <Grid Margin="24,20,24,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Background only, spanning the button's column too: the
                                 reactor is part of this area, not a thing parked beside
                                 it. Its own art covers the acrylic completely, so this is
                                 structural rather than something you can see. -->
                            <Border x:Name="AlchitexPanelBackground"
                                    Grid.ColumnSpan="2"
                                    CornerRadius="8">
                                <Border.Background>
                                    <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                                                  TintOpacity="0.6"
                                                  FallbackColor="{ThemeResource OverlayBackgroundColor}" />
                                </Border.Background>
                            </Border>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="260" />
                                    <!-- options -->
                                    <ColumnDefinition Width="3" />
                                    <!-- bevel, light edge -->
                                    <ColumnDefinition Width="3" />
                                    <!-- bevel, dark edge -->
                                    <ColumnDefinition Width="*" />
                                    <!-- pack queue -->
                                </Grid.ColumnDefinitions>

                                <!-- ── Options ── -->
                                <StackPanel Grid.Column="0"
                                            Margin="24,24,24,24"
                                            Spacing="24"
                                            VerticalAlignment="Top">

                                    <ComboBox x:Name="SecondaryPbrModeComboBox"
                                              Header="Secondary PBR texture"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="1"
                                              IsTextScaleFactorEnabled="False">
                                        <ComboBoxItem Content="None" />
                                        <ComboBoxItem Content="Auto" />
                                        <ComboBoxItem Content="Normal map" />
                                        <ComboBoxItem Content="Heightmap" />
                                    </ComboBox>

                                    <ToggleSwitch x:Name="AddFogToggle"
                                                  Header="Add RTX compatible per-biome configs"
                                                  IsOn="True"
                                                  IsTextScaleFactorEnabled="False" />

                                    <ToggleSwitch x:Name="DeleteOriginalToggle"
                                                  Header="Uninstall the original pack"
                                                  IsOn="False"
                                                  IsTextScaleFactorEnabled="False"
                                                  ToolTipService.ToolTip="Deletes each selected pack from your installed packs once its RTX version has been generated successfully. Nothing is deleted if generation fails." />
                                </StackPanel>

                                <!-- ── Bevel: light rule then dark rule, the same pairing
                                     the titlebar and the main window's button groups use.
                                     Two flat fills reading as one carved edge. ── -->
                                <Border Grid.Column="1"
                                        Background="{ThemeResource CardBackgroundFillColorSecondary}"
                                        Opacity="0.5"/>
                                <Border Grid.Column="2"
                                        Background="{ThemeResource SystemControlPageBackgroundListLowBrush}"
                                        Opacity="0.5"/>

                                <!-- ══ PACK QUEUE ═══════════════════════════════════
                                     Two rows, both built in code-behind: what's waiting
                                     to go into the reactor on top, what has come out of
                                     it underneath. Each scrolls horizontally on its own,
                                     so nothing is ever hidden behind a "+N" - every pack
                                     stays reachable, which matters now that each tile
                                     carries its own discard button.
                                     ═══════════════════════════════════════════════ -->
                                <Grid x:Name="PackQueueHost"
                                      Grid.Column="3"
                                      Margin="16,12,16,12"
                                      SizeChanged="PackQueueHost_SizeChanged">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Direction markers, sitting behind the tiles: into
                                         the reactor on top, back out underneath. They
                                         earn their keep most when a row is empty, which
                                         is otherwise just blank space with no clue what
                                         it's for. -->
                                    <FontIcon Grid.Row="0"
                                              Glyph="&#xE72A;"
                                              FontSize="64"
                                              Opacity="0.15"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              IsTextScaleFactorEnabled="False" />

                                    <FontIcon Grid.Row="1"
                                              Glyph="&#xE72B;"
                                              FontSize="64"
                                              Opacity="0.15"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              IsTextScaleFactorEnabled="False" />

                                    <ScrollViewer Grid.Row="0"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  HorizontalScrollMode="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  VerticalScrollMode="Disabled">
                                        <StackPanel x:Name="InputQueuePanel"
                                                    Orientation="Horizontal"
                                                    Spacing="12"
                                                    VerticalAlignment="Center" />
                                    </ScrollViewer>

                                    <ScrollViewer Grid.Row="1"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  HorizontalScrollMode="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  VerticalScrollMode="Disabled">
                                        <StackPanel x:Name="OutputQueuePanel"
                                                    Orientation="Horizontal"
                                                    Spacing="12"
                                                    VerticalAlignment="Center" />
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <!-- ══ THE REACTOR ══════════════════════════════════════
                                 Three stacked layers, driven by ReactorAnimator:
                                   1. a 3x3 grid of tiles, built in code, whose colors
                                      react to what generation is actually doing;
                                   2. the static logo;
                                   3. the same mark with its bloom, whose opacity is the
                                      other half of the animation vocabulary.
                                 Square by construction - its side is kept equal to the
                                 panel's height in code, so changing the area's height is
                                 all it takes to resize the reactor.
                                 ═════════════════════════════════════════════════ -->
                            <Button x:Name="GenerateButton"
                                    Grid.Column="1"
                                    Width="300"
                                    Height="300"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    Padding="0"
                                    ToolTipService.ToolTip="Begin the generation process."
                                    IsTextScaleFactorEnabled="False"
                                    Click="GenerateButton_Click">
                                <Grid IsHitTestVisible="False">
                                    <Grid x:Name="ReactorTileGrid" />

                                    <Image x:Name="ReactorLogo"
                                           Source="ms-appx:///Modules/Alchitex/Assets/reactor.logo.png"
                                           Stretch="Uniform" />

                                    <Image x:Name="ReactorBloom"
                                           Source="ms-appx:///Modules/Alchitex/Assets/reactor.bloom.png"
                                           Stretch="Uniform"
                                           Opacity="0.35" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>


                    <!-- ── Progress bar, sitting on the seam between the controls and
                         the announcements ── -->
                    <ProgressBar x:Name="GenerateProgressBar"
                                 Grid.Row="1"
                                 Visibility="Collapsed"
                                 IsIndeterminate="False"
                                 Minimum="0"
                                 Maximum="1"
                                 Margin="0"
                                 CornerRadius="0"
                                 HorizontalAlignment="Stretch" />

                    <!-- ── PSA / announcements ── -->
                    <Border x:Name="AnnouncementBackground"
                            Grid.Row="2"
                            Padding="6"
                            CornerRadius="0"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom">
                        <Border.Background>
                            <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                                          TintOpacity="0.6"
                                          FallbackColor="{ThemeResource OverlayBackgroundColor}" />
                        </Border.Background>

                        <StackPanel x:Name="AlchitexAnnouncementsPanel"
                                    Spacing="12"
                                    Margin="24,12,24,12" />
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>



    </Grid>
</Window>
