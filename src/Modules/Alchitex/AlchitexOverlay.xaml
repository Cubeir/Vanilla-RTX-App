<?xml version="1.0" encoding="utf-8"?>
<overlays:ModuleOverlay x:Class="Vanilla_RTX_App.Modules.Alchitex.Alchitex"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="using:Vanilla_RTX_App.Modules.Alchitex"
                        xmlns:overlays="using:Vanilla_RTX_App.Core.Overlays"
                        IsTextScaleFactorEnabled="False">


    <Grid>
        <!--  BACKGROUND FIELD
              Generated by ReactorBackdrop, which owns everything about it
              including its own SizeChanged. This Border is only the
              surface it hosts its composition visual on, which is why it has no Background
              of its own: if the backdrop can't be built, what shows through is the window's
              acrylic, not a half-drawn stand-in.  -->
        <Border x:Name="AlchitexBackdropHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                Canvas.ZIndex="-2" />

        <Border x:Name="AlchitexBackdropStaticColor"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#FF00244A"
                Opacity="{ThemeResource AlchitexBackdropStaticColorOpacity}"
                IsHitTestVisible="False"
                Canvas.ZIndex="-3" />

        <!-- ══ TITLEBAR ACTIONS - post-license, and not rendered here ════════════
             Declared in this class so its buttons' x:Name fields and handlers belong to it,
             but ModuleOverlayTitleBar takes the whole Border and shows it in MainWindow's
             titlebar for as long as this module is open, where it reads as a continuation of
             the buttons already there. That control owns the placement and the divider in
             front of it - this is only what goes in it, sized the way MainWindow sizes its
             own. See ModuleOverlay.TitleBarStrip.

             One of the two containers that make up the post-license UI (the other is
             MainGrid). Everything in here is hidden until the license is accepted, and
             children inherit that, so a new titlebar control added inside this Border needs
             NO code in ShowMainContent - just drop it in.

             Documentation is MainWindow's Help button, right beside this strip, which renders
             the same document.
             ═══════════════════════════════════════════════════════════════════ -->
        <Border x:Name="TitleBarActions"
                Visibility="Collapsed">
            <Grid Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1">
                <!-- Debug builds only. The single #if DEBUG line in ShowMainContent covers
                     everything in here, so a new dev-only titlebar control just goes inside. -->
                <StackPanel x:Name="DevOnlyTitleBarActions"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                    <!-- materials.json authoring: bootstrap new entries from an
                         already-PBR'd pack, or collapse the file down to the properties
                         that actually change what the pipeline produces. Click opens a
                         menu over the two, the same way the test bench does. -->
                    <Button x:Name="GenerateMaterialsConfigButton"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Content="&#xEC7A;"
                            Width="40"
                            Height="35"
                            CornerRadius="0"
                            FontSize="16"
                            Click="GenerateMaterialsConfigButton_Click"
                            ToolTipService.ToolTip="DEVELOPER TOOL: BOOTSTRAP MATERIALS.JSON ENTRIES FROM AN EXISTING PBR TEXTURE PACK, OR OPTIMIZE AN EXISTING MATERIALS.JSON BY REMOVING EVERY PROPERTY THE PIPELINE WOULD HAVE ARRIVED AT ANYWAY."
                            IsTextScaleFactorEnabled="False" />
                    
                    <!-- Separator -->
                    <Border Width="1"
                            Margin="2,6,2,6"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- PBR test bench: run loose textures through the generation path
                         without building a pack around them. Also a drop target - files
                         or folders dragged onto it skip the picker entirely. -->
                    <Button x:Name="PipelinePreviewDevToolButton"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Content="&#xED5E;"
                            Width="40"
                            Height="35"
                            CornerRadius="0"
                            FontSize="16"
                            Click="PipelinePreviewDevToolButton_Click"
                            AllowDrop="True"
                            DragOver="PipelinePreviewDevToolButton_DragOver"
                            Drop="PipelinePreviewDevToolButton_Drop"
                            ToolTipService.ToolTip="DEVELOPER TOOL: GENERATE PBR FOR LOOSE TEXTURES OR A WHOLE FOLDER, IN PLACE, WITHOUT BUILDING A PACK. DROP FILES OR FOLDERS HERE, OR CLICK TO PICK. EXISTING PBR IN THE TARGET FOLDERS IS STRIPPED AND REGENERATED."
                            IsTextScaleFactorEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  LOADING PANEL                                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="LoadingPanel"
              Visibility="Visible"
              Background="Transparent">
            <ProgressRing IsActive="True"
                          Width="100"
                          Height="100"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  LICENSE PANEL                                          -->
        <!--  Sits BELOW the shared titlebar                         -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="LicensePanel"
              Visibility="Collapsed"
              Background="{ThemeResource OverlayBackgroundColor}"
              Padding="16, 0, 16 16"
              Opacity="1.0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- license text  -->
                <RowDefinition Height="Auto" />
                <!-- buttons       -->
            </Grid.RowDefinitions>
            
            <!-- ── License RichTextBlock ── -->
            <Grid Grid.Row="0"
                  Margin="64,32,64,32"
                  Translation="0,0,128">
                <Grid.Shadow>
                    <ThemeShadow x:Name="LicenseTextShadow" />
                </Grid.Shadow>
                <Border x:Name="LicenseAcrylicBackground"
                        CornerRadius="0">
                    <Border.Background>
                        <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                                      TintOpacity="0.5"
                                      FallbackColor="{ThemeResource OverlayBackgroundColor}" />
                    </Border.Background>
                </Border>
                <ScrollViewer BorderBrush="#15FFFFFF"
                              BorderThickness="0.5"
                              CornerRadius="0"
                              Background="Transparent"
                              VerticalScrollBarVisibility="Auto">
                    <RichTextBlock x:Name="LicenseTextBlock"
                                   IsTextSelectionEnabled="False"
                                   Padding="24"
                                   TextWrapping="Wrap"
                                   IsTabStop="False"
                                   FontSize="14"
                                   LineHeight="20"
                                   IsTextScaleFactorEnabled="False"
                                   HorizontalAlignment="Center">
                        <!-- Populated in code-behind -->
                    </RichTextBlock>
                </ScrollViewer>
            </Grid>

            <!-- ── Action buttons ── -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="16"
                        Background="Transparent"
                        Margin="0,0,0,24">

                <Grid>
                    <Border x:Name="DisagreeButtonAcrylicBackground"
                            CornerRadius="4">
                        <Border.Background>
                            <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                                          TintOpacity="0.75"
                                          FallbackColor="{ThemeResource OverlayBackgroundColor}" />
                        </Border.Background>
                    </Border>
                    <Button x:Name="DisagreeButton"
                            Padding="16,16,16,16"
                            IsTextScaleFactorEnabled="False"
                            Translation="0,0,32"
                            CornerRadius="0"
                            Click="DisagreeButton_Click"
                            Content="Disagree and close"
                            Background="Transparent"
                            Style="{ThemeResource DefaultButtonStyle}">
                        <Button.Shadow>
                            <ThemeShadow x:Name="DisagreeShadow" />
                        </Button.Shadow>

                    </Button>
                </Grid>

                <Button x:Name="AgreeButton"
                        Padding="16,16,16,16"
                        Style="{ThemeResource AccentButtonStyle}"
                        IsTextScaleFactorEnabled="False"
                        Translation="0,0,32"
                        CornerRadius="0"
                        Content="I have read and agreed to the terms and conditions of RTX Reactor"
                        Click="AgreeButton_Click">
                    <Button.Shadow>
                        <ThemeShadow x:Name="AgreeShadow" />
                    </Button.Shadow>
                </Button>

            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  MAIN CONTENT GRID - post-license                                   -->
        <!--                                                                     -->
        <!--  The second of the two post-license containers (TitleBarActions up  -->
        <!--  in the titlebar is the other). Everything the user sees after      -->
        <!--  accepting the license lives in one of those two, and children       -->
        <!--  inherit the container's visibility - so adding a control here needs -->
        <!--  no matching line in ShowMainContent. Don't collapse new controls    -->
        <!--  individually unless they're meant to stay hidden for some OTHER     -->
        <!--  reason (AbortButton, the progress bar and status text do that -     -->
        <!--  they're driven by generation state, not by license state).          -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="MainGrid"
              Visibility="Collapsed"
              Background="Transparent">

            <!-- ══ ONE SCROLLER FOR THE WHOLE WINDOW ════════════════════════════
                 The controls area is a fixed 512px tall and never scales with the
                 window; the announcements below it are whatever height their cards
                 add up to. Together they overflow the window once there are enough
                 PSAs, and that is what the scrollbar is for - there's no second,
                 nested scroller inside the announcements panel any more.

                 AnnouncementBackground.MinHeight is kept in sync with the leftover
                 viewport height in code-behind (SyncAnnouncementMinHeight), so with
                 only a card or two the acrylic panel still reaches the bottom edge
                 instead of leaving the window background showing under it.
                 ═══════════════════════════════════════════════════════════════ -->
            <ScrollViewer x:Name="MainScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          SizeChanged="MainScrollViewer_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Alchitex controls - fixed height -->
                        <RowDefinition Height="Auto" />
                        <!-- announcements, with the bevel seam drawn on its own top edge -->
                    </Grid.RowDefinitions>

                    <!-- ══ ALCHITEX CONTROLS ════════════════════════════════════
                         Fixed 512px including its own margins, so the panel inside
                         is a predictable size no matter how tall the window gets -
                         everything that grows lives below this.

                         Three areas, left to right: options, the queued packs'
                         icons, and the giant Generate button. The first two sit on
                         one acrylic panel (same material as the announcements
                         below); the button sits flush against its right edge with
                         the window background behind it, so it reads as its own
                         object rather than another card.
                         ═════════════════════════════════════════════════════ -->
                    <Grid x:Name="AlchitexControlsArea"
                          Grid.Row="0"
                          Height="333"
                          Canvas.ZIndex="2"
                          Translation="0,0,64"
                          SizeChanged="AlchitexControlsArea_SizeChanged">
                        <Grid.Shadow>
                            <ThemeShadow />
                        </Grid.Shadow>
                        <Grid Margin="24,20,24,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Background only, spanning the button's column too: the
                                 reactor is part of this area, not a thing parked beside
                                 it. Its own art covers the acrylic completely, so this is
                                 structural rather than something you can see. -->
                            <!-- Translation Z + ThemeShadow, the same pairing the titlebar
                                 uses, but pushed much further out: this is meant to read as
                                 an island floating well above the window's background art
                                 rather than a panel resting on it. It spans the reactor's
                                 column too, so the shadow wraps the whole area as one
                                 object instead of stopping at the button's edge. -->
                            <Border x:Name="AlchitexPanelBackground"
                                    Grid.ColumnSpan="2"
                                    CornerRadius="0"
                                    Translation="0,0,64">
                                <Border.Background>
                                    <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                                                  TintOpacity="0.75"
                                                  FallbackColor="{ThemeResource OverlayBackgroundColor}" />
                                </Border.Background>
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>
                            </Border>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="260" />
                                    <!-- options -->
                                    <ColumnDefinition Width="3" />
                                    <!-- bevel, light edge -->
                                    <ColumnDefinition Width="3" />
                                    <!-- bevel, dark edge -->
                                    <ColumnDefinition Width="*" />
                                    <!-- pack queue -->
                                </Grid.ColumnDefinitions>

                                <!-- ── Options ── -->
                                <Border Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        CornerRadius="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Padding="0"
                                        Translation="0,0,256">
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="300" />
                                            <!-- options -->
                                            <ColumnDefinition Width="3" />
                                            <!-- bevel, light edge -->
                                            <ColumnDefinition Width="3" />
                                            <!-- bevel, dark edge -->
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Margin="24,24,24,24"
                                                    Spacing="32"
                                                    VerticalAlignment="Top">

                                            <!-- A DropDownButton rather than a ComboBox: its
                                                 flyout is translucent out of the box, the way
                                                 the rest of the window is, where a ComboBox's
                                                 popup stays opaque even with
                                                 ComboBoxDropDownBackground overridden. Same
                                                 pattern LUTManagerOverlay uses. The items and
                                                 the button's own text are built in
                                                 BuildSecondaryPbrMenu. -->
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="SecondaryPbrModeLabel"
                                                           Text="Secondary PBR texture"
                                                           IsTextScaleFactorEnabled="False" />

                                                <DropDownButton x:Name="SecondaryPbrModeButton"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                IsTextScaleFactorEnabled="False"
                                                                ToolTipService.ToolTip="None: all textures will appear flat.
                                                                &#x0a;Automatic: automatically picks between Normal map and Heightmap depending on texture resolution.
                                                                &#x0a;Normal map: fakes depth on textures by defining how light bounces off of each individual pixel on textures + Parallax Occlusion Mapping data when supported.
                                                                &#x0a;Heightmap: uses height information to create depth perception on textures specifically for low resolution textures (Recommended only for texture packs lower than 32x).">
                                                    <DropDownButton.Flyout>
                                                        <MenuFlyout Placement="Bottom" />
                                                    </DropDownButton.Flyout>
                                                </DropDownButton>
                                            </StackPanel>

                                            <ToggleSwitch x:Name="AddFogToggle"
                                                          Header="Add per-biome RTX atmospheric configs"
                                                          IsOn="True"
                                                          Margin="0,4,0,0"
                                                          IsTextScaleFactorEnabled="False"
                                                          ToolTipService.ToolTip="Adds detailed per-biome fog settings to packs provided by Vanilla RTX, this may override their existing per-biome configurations.
                                                          &#x0a;&#x0a;This is generally recommended for most packs, otherwise there likely won't be any fog, light shafts or other unique atmospheric treats across biomes such as different water colors." />

                                            <ToggleSwitch x:Name="DeleteOriginalToggle"
                                                          Header="Uninstall the original pack"
                                                          IsOn="False"
                                                          Margin="0,-8,0,0"
                                                          IsTextScaleFactorEnabled="False"
                                                          ToolTipService.ToolTip="Deletes each pack from your installed packs once its RTX version is finished and installed.
                                                          &#x0a;&#x0a;Nothing is deleted if generation fails or is otherwise stopped mid operation." />
                                        </StackPanel>

                                        <!-- ── Bevel: light rule then dark rule, the same pairing
                                             the titlebar and the main window's button groups use.
                                             Two flat fills reading as one carved edge. ── -->
                                        <Border Grid.Column="1"
                                                Background="{ThemeResource CardBackgroundFillColorSecondary}"
                                                Opacity="0.33"/>
                                        <Border Grid.Column="2"
                                                Background="{ThemeResource CardBackgroundFillColorSecondary}"
                                                Opacity="0.66"/>
                                    </Grid>
                                </Border>

                                <!-- ══ PACK QUEUE ═══════════════════════════════════
                                     Two rows, both built in code-behind: what's waiting
                                     to go into the reactor on top, what has come out of
                                     it underneath. Each scrolls horizontally on its own,
                                     so nothing is ever hidden behind a "+N" - every pack
                                     stays reachable, which matters now that each tile
                                     carries its own discard button.
                                     ═══════════════════════════════════════════════ -->
                                <Grid x:Name="PackQueueHost"
                                      Grid.Column="3"
                                      Margin="16,12,16,12"
                                      SizeChanged="PackQueueHost_SizeChanged">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Direction markers, sitting behind the tiles: into
                                         the reactor on top, back out underneath. They
                                         earn their keep most when a row is empty, which
                                         is otherwise just blank space with no clue what
                                         it's for. -->
                                    <FontIcon Grid.Row="0"
                                              ToolTipService.ToolTip="Packs queued for RTX generation"
                                              Glyph="&#xE72A;"
                                              FontSize="64"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource CardBackgroundFillColorSecondary}"
                                              Opacity="1.0"
                                              IsHitTestVisible="False"
                                              IsTextScaleFactorEnabled="False" />

                                    <FontIcon Grid.Row="1"
                                              ToolTipService.ToolTip="Packs that have finished generating"
                                              Glyph="&#xE72B;"
                                              FontSize="64"
                                              Foreground="{ThemeResource CardBackgroundFillColorSecondary}"
                                              Opacity="1.0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              IsTextScaleFactorEnabled="False" />

                                    <!-- Spacing="0" on both panels below deliberately - the
                                         perceived gap between icons now comes from padding
                                         inside each tile's own container (BuildPackTile,
                                         TileShadowPadding), which doubles as headroom for
                                         the icon's drop shadow instead of clipping it flat.
                                         The -5 TranslateY nudges every tile up by that much,
                                         clearing the auto-hiding horizontal scrollbar that
                                         overlays the bottom of the row instead of reserving
                                         its own space - see PackQueueHost_SizeChanged for
                                         the matching size reduction. -->
                                    <ScrollViewer Grid.Row="0"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  HorizontalScrollMode="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  VerticalScrollMode="Disabled">
                                        <StackPanel x:Name="InputQueuePanel"
                                                    Orientation="Horizontal"
                                                    Spacing="0"
                                                    VerticalAlignment="Center">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform Y="-5" />
                                            </StackPanel.RenderTransform>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer Grid.Row="1"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  HorizontalScrollMode="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  VerticalScrollMode="Disabled">
                                        <StackPanel x:Name="OutputQueuePanel"
                                                    Orientation="Horizontal"
                                                    Spacing="0"
                                                    VerticalAlignment="Center">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform Y="-5" />
                                            </StackPanel.RenderTransform>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <!-- ══ THE REACTOR ══════════════════════════════════════
                                 Three stacked layers, driven by ReactorAnimator:
                                   1. a 3x3 grid of tiles, built in code, whose colors
                                      react to what generation is actually doing;
                                   2. the static logo;
                                   3. the same mark with its bloom, whose opacity is the
                                      other half of the animation vocabulary.
                                 Square by construction - its side is kept equal to the
                                 panel's height in code, so changing the area's height is
                                 all it takes to resize the reactor.
                                 ═════════════════════════════════════════════════ -->
                            <Button x:Name="GenerateButton"
                                    Grid.Column="1"
                                    Width="300"
                                    Height="300"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    Padding="0"
                                    ToolTipService.ToolTip="Begin the generation process."
                                    IsTextScaleFactorEnabled="False"
                                    Translation="0,0,256"
                                    Click="GenerateButton_Click">
                                <Button.Shadow>
                                    <ThemeShadow />
                                </Button.Shadow>
                                <Grid IsHitTestVisible="False">
                                    <Grid x:Name="ReactorTileGrid" />

                                    <Image x:Name="ReactorLogo"
                                           Source="ms-appx:///Modules/Alchitex/Assets/reactor.logo.png"
                                           Stretch="Uniform" />

                                    <Image x:Name="ReactorBloom"
                                           Source="ms-appx:///Modules/Alchitex/Assets/reactor.bloom.png"
                                           Stretch="Uniform"
                                           Opacity="0.6" />
                                </Grid>
                            </Button>

                        </Grid>
                    </Grid>

                    <!-- ══ WHERE A FAILED PACK GETS THROWN ═══════════════════
                         It has to live outside the queue rows: those are ScrollViewers,
                         which clip, so a tile flung at the reactor would vanish at the
                         panel's edge instead of being seen leaving through it.

                         A failed pack drops out of the reactor's underside, so this must
                         render BENEATH the button and ABOVE what sits below it - the tile
                         starts hidden behind the reactor and only appears once it clears
                         the bottom edge, which is what makes it read as falling out of the
                         thing rather than sliding across the front of it.

                         That sandwich is why this is a sibling of the controls area rather
                         than a child of it. Canvas.ZIndex only orders siblings, and inside
                         the controls area there is no index that is under the button and
                         over the announcements at the same time. The three explicit indices
                         are the ordering - controls area (2), this (1), announcements (0) -
                         and none of the three may be dropped.

                         A Canvas rather than a Grid, and that part is load-bearing: it
                         spans both rows, and a Grid takes its children's size as its own,
                         so a tile parked a few hundred pixels down would inflate the Auto
                         row it spans into and push the announcements around. A Canvas
                         measures to nothing, so the layout never learns this is here.
                         ═════════════════════════════════════════════════ -->
                    <Canvas x:Name="QueueEjectionHost"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            IsHitTestVisible="False"
                            Canvas.ZIndex="1" />


                    <!-- ── PSA / announcements ── -->
                    <Border x:Name="AnnouncementBackground"
                            Grid.Row="1"
                            Canvas.ZIndex="2"
                            Padding="6"
                            BorderThickness="0"
                            CornerRadius="0"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom">
                        <Border.Background>
                            <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                                          TintOpacity="0.75"
                                          FallbackColor="{ThemeResource OverlayBackgroundColor}" />
                        </Border.Background>

                        <Grid>
                            <!-- Wraps the PSA panel and the Ko-fi section so the latter
                                 stacks directly beneath the former. Has to be a separate
                                 StackPanel rather than putting SupportSection straight into
                                 AlchitexAnnouncementsPanel - PsaCard.Populate() clears that
                                 panel's children outright on every refresh. -->
                            <StackPanel>
                                <StackPanel x:Name="AlchitexAnnouncementsPanel"
                                            Spacing="12"
                                            Margin="24,18,24,12" />

                                <!-- ══ KO-FI SECTION ══════════════════════════════
                                     Auto-scrolled into view once a generation batch finishes
                                     (TriggerSupportScrollAsync), at most once per day - see
                                     AlchitexVariables.Persistent.LastSupportScrollUtc.
                                     ═════════════════════════════════════════════════════ -->
                                <Border x:Name="SupportSection"
                                        Margin="24,0,24,18"
                                        CornerRadius="0"
                                        Padding="20,18,20,18"
                                        Translation="0,0,32"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>

                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="10">
                                            <FontIcon Glyph="&#xEB52;"
                                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      FontSize="16"
                                                      Margin="0,2,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      IsTextScaleFactorEnabled="False" />
                                            <TextBlock Text="Enjoying RTX Reactor?"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       IsTextScaleFactorEnabled="False" />
                                        </StackPanel>

                                        <TextBlock x:Name="SupportPersuasionText"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   LineHeight="20"
                                                   Opacity="0.9"
                                                   IsTextScaleFactorEnabled="False" />

                                        <Button x:Name="SupportKofiButton"
                                                HorizontalAlignment="Left"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                Click="SupportKofiButton_Click"
                                                IsTextScaleFactorEnabled="False"
                                                ToolTipService.ToolTip="Opens ko-fi.com/cubeir in your default browser.">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <TextBlock Text="Become an Insider on Ko-Fi"
                                                           IsTextScaleFactorEnabled="False"
                                                           FontWeight="Medium"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ── Seam: 6px bevel drawn directly on the acrylic's own top
                                 edge, rather than a separate row before it - so the controls
                                 area's shadow lands right on the acrylic with no gap. The
                                 negative margin reaches back out through this Border's own
                                 Padding to sit flush with its true top/left/right edges.

                                 Two flat 3px fills read as one carved-in groove - dark edge
                                 above, light edge below - mirrored horizontally from the
                                 options/queue bevel above.

                                 The progress bar shares this same 6px strip: at rest the
                                 bevel alone reads as the seam, and while generation runs the
                                 bar is exactly as thick as the seam so it covers both lines
                                 outright instead of sitting as a thin sliver on top. ── -->
                            <Grid VerticalAlignment="Top"
                                  Height="6"
                                  Margin="-6,-6,-6,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3" />
                                    <!-- bevel, dark edge -->
                                    <RowDefinition Height="3" />
                                    <!-- bevel, light edge -->
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Margin="0,1,0,0"
                                        Background="{ThemeResource CardBackgroundFillColorSecondary}"
                                        Opacity="0.8" />
                                <Border Grid.Row="1"
                                        Background="{ThemeResource CardBackgroundFillColorSecondary}"
                                        Opacity="0.4" />

                                <ProgressBar x:Name="GenerateProgressBar"
                                             Grid.RowSpan="2"
                                             Height="6"
                                             VerticalAlignment="Stretch"
                                             Visibility="Collapsed"
                                             IsIndeterminate="False"
                                             Minimum="0"
                                             Maximum="1"
                                             Margin="0,-4,0,0"
                                             CornerRadius="0"
                                             HorizontalAlignment="Stretch" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>



    </Grid>
</overlays:ModuleOverlay>
