<Window x:Class="Vanilla_RTX_App.Modules.DLSSSwapperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Vanilla_RTX_App.Modules"
        Title="DLSS Swapper">
    
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    
    <Grid>
        <Border x:Name="LightThemeOverlay"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                Visibility="{ThemeResource LightThemeBackgroundVisibility}"
                Canvas.ZIndex="-1">
            <Border.Background>
                <SolidColorBrush Color="#17373737" />
            </Border.Background>
        </Border>

        <!-- Loading Screen -->
        <Grid x:Name="LoadingPanel"
              Visibility="Visible"
              Background="Transparent">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="20">
                <ProgressRing IsActive="True"
                              Width="100"
                              Height="100" />

                <Button x:Name="ManualSelectionButton"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Padding="20,12,20,12"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="ManualSelectionButton_Click">
                    <StackPanel Spacing="10">
                        <TextBlock Text="The app couldn't auto-locate your game files using the usual fast methods!&#x0a;A system-wide scan is in progress, there is a high chance it will find your game given enough time."
                                   FontSize="15"
                                   TextAlignment="Center"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   IsTextScaleFactorEnabled="False" />
                        <TextBlock x:Name="ManualSelectionText"
                                   Text="But if it is taking too long? Click to manually navigate to the folder where the game is installed to, it should have a file called Minecraft.Windows.exe inside of it.
                                   &#x0a;&#x0a;The app is tolerant towards slightly imprecise location selections, it will still try to have a look around no matter where you select, but if you're still having trouble finding out where your game is installed to, join the Vanilla RTX Discord server and ask for help, or try to find out online."
                                   FontSize="13"
                                   Opacity="0.8"
                                   FontWeight="Medium"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"
                                   IsTextScaleFactorEnabled="False" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- DLL Selection UI -->
        <Grid x:Name="DllSelectionPanel"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar Area -->
            <Grid Grid.Row="0"
                  x:Name="TitleBarArea"
                  Background="Transparent">
                <!-- Centered Title -->
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <TextBlock Text=""
                               Margin="0,0,0,0"
                               VerticalAlignment="Center"
                               IsTextScaleFactorEnabled="False"
                               IsHitTestVisible="False"
                               x:Name="WindowTitle" />
                </Grid>
            </Grid>

            <!-- DLL List + fixed Add DLSS files bar -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <!-- DLL list (scrollable) -->
                    <RowDefinition Height="*" />
                    <!-- Add DLSS files (fixed) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="ShadowReceiverGrid"
                      Grid.Row="0" />

                <ScrollViewer Grid.Row="0"
                              Padding="20,0,20,0"
                              Margin="0,0,0,0"
                              IsTextScaleFactorEnabled="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel x:Name="DLSSAnnouncementsPanel"
                                    Spacing="12"
                                    Margin="0,0,0,0" />
                        <StackPanel x:Name="DllListContainer"
                                    Spacing="8"
                                    Padding="0,0,0,8"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════════════════════════════════════
                     FIXED: Add DLSS files
                ═══════════════════════════════════════════ -->
                <Button x:Name="AddDllButton"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="36,16,40,16"
                        Margin="0"
                        CornerRadius="0"
                        IsTextScaleFactorEnabled="False"
                        Translation="0,2,512"
                        AllowDrop="True"
                        Click="AddDllButton_Click"
                        DragOver="AddDllButton_DragOver"
                        DragEnter="AddDllButton_DragEnter"
                        DragLeave="AddDllButton_DragLeave"
                        Drop="AddDllButton_Drop">
                    <Button.Shadow>
                        <ThemeShadow />
                    </Button.Shadow>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="75"
                                Height="75"
                                CornerRadius="5"
                                Background="Transparent">
                            <FontIcon Glyph="&#xE710;"
                                      FontSize="48"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsTextScaleFactorEnabled="False" />
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Add DLSS files"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       IsTextScaleFactorEnabled="False" />
                            <TextBlock Text="Drag and drop or browse for a DLSS DLL file to add (.dll or .zip with the dlls)"
                                       FontSize="12"
                                       Opacity="0.75"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       IsTextScaleFactorEnabled="False" />
                        </StackPanel>

                        <HyperlinkButton Grid.Column="4"
                                         Content="Download DLSS files from here"
                                         NavigateUri="https://www.techpowerup.com/download/nvidia-dlss-dll/"
                                         VerticalAlignment="Center"
                                         FontWeight="Medium"
                                         FontSize="14"
                                         Padding="16,8,16,8"
                                         Translation="0,0,8"
                                         IsTextScaleFactorEnabled="False"
                                         Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                         CornerRadius="6">
                            <HyperlinkButton.Shadow>
                                <ThemeShadow />
                            </HyperlinkButton.Shadow>
                        </HyperlinkButton>
                    </Grid>
                </Button>
            </Grid>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Spacing="12">
                <FontIcon Glyph="&#xF158;"
                          FontSize="48"
                          IsTextScaleFactorEnabled="False"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyStateText"
                           Text="No DLSS versions cached"
                           FontSize="14"
                           IsTextScaleFactorEnabled="False"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
