<overlays:ModuleOverlay x:Class="Vanilla_RTX_App.Modules.PackBrowser.PackBrowserOverlay"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="using:Vanilla_RTX_App.Modules.PackBrowser"
                        xmlns:overlays="using:Vanilla_RTX_App.Core.Overlays"
                        IsTextScaleFactorEnabled="False">


    <Grid>

        <!-- Light-theme tint overlay -->

        <!-- ═══════════════════════════════════════════════════
             LOADING SCREEN
        ════════════════════════════════════════════════════ -->
        <Grid x:Name="LoadingPanel"
              Visibility="Visible"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RowSpacing="20"
              Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressRing IsActive="True"
                          Width="100"
                          Grid.Row="0"
                          Height="100" />
            <TextBlock Text="Loading your installed packs..."
                       Grid.Row="1"
                       FontSize="14"
                       Opacity="0.75"
                       FontWeight="Normal"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       IsTextScaleFactorEnabled="False" />
        </Grid>

        <!-- ═══════════════════════════════════════════════════
             MAIN PANEL (title bar + scrollable content)
        ════════════════════════════════════════════════════ -->
        <Grid x:Name="PackSelectionPanel"
              Visibility="Collapsed">
            <!-- ── Content area - one flat area. ─────────────────────────────── -->
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Announcements (PSA cards, auto-height) -->
                    <RowDefinition Height="Auto" />
                    <!-- Pack list (scrollable)                 -->
                    <RowDefinition Height="*" />
                    <!-- Bottom action bar (confirm + import)   -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Shadow receiver sits behind everything -->
                <Grid x:Name="ShadowReceiverGrid"
                      Grid.Row="1" />

                <!-- PACK LIST (scrollable) -->
                <ScrollViewer Grid.Row="1"
                              IsTextScaleFactorEnabled="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,0">

                    <!-- Wrap both panels in a single parent StackPanel -->
                    <StackPanel>

                        <!-- PSA / announcement cards -->
                        <StackPanel x:Name="PackBrowserAnnouncementsPanel"
                                    Spacing="10"
                                    Margin="20,12,24,0" />

                        <!-- Pack list -->
                        <StackPanel x:Name="PackListContainer"
                                    Spacing="4"
                                    Margin="20,12,24,0"
                                    Padding="0,0,0,8" />

                    </StackPanel>
                </ScrollViewer>

                <!-- Empty state overlays the scroll area -->
                <StackPanel x:Name="EmptyStatePanel"
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Spacing="12">
                    <FontIcon Glyph="&#xE7C3;"
                              FontSize="48"
                              IsTextScaleFactorEnabled="False"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="EmptyStateText"
                               Text="You don't seem to have any resource pack installed! Begin importing your packs here, or install Vanilla RTX from the main menu."
                               FontSize="14"
                               IsTextScaleFactorEnabled="False"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- ══════════════════════════════════════════
                     BOTTOM ACTION BAR
                ═══════════════════════════════════════════ --> 
                <Border Grid.Row="2"
                        Margin="0"
                        CornerRadius="0"
                        BorderThickness="0"
                        Translation="0,2,512"
                        Background="Transparent">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>

                    <Grid Padding="0,0,0,0"
                          MinHeight="92"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Bottom">
                        <!-- Import activity, on the action bar's top edge.
                             This is what the titlebar's "extracting ... " line became: the
                             titlebar belongs to MainWindow now and cannot say anything about
                             one module. Spanning the bar's full width and sitting on its seam
                             reads as the bar itself being busy, which is exactly what it is -
                             the two buttons under it are what the import is running from. -->
                        <Grid.ColumnDefinitions>
                            <!-- Select All -->
                            <ColumnDefinition Width="70" />
                            <!-- Gap 6 px -->
                            <ColumnDefinition Width="6" />
                            <!-- Confirm -->
                            <ColumnDefinition Width="1.8*" />
                            <!-- Gap 6 px -->
                            <ColumnDefinition Width="6" />
                            <!-- Import -->
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar x:Name="ImportProgressBar"
                                     Grid.ColumnSpan="5"
                                     Height="3"
                                     Margin="0,-2,0,0"
                                     VerticalAlignment="Top"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     Canvas.ZIndex="10"
                                     IsHitTestVisible="False" />

                        <DropDownButton x:Name="SelectAll_Button"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        IsTextScaleFactorEnabled="False"
                                        ToolTipService.ToolTip="Select all by tag or deselect all">
                            <Grid>
                                <FontIcon x:Name="SelectAllButton_Glyph"
                                          Glyph="&#xE762;"
                                          FontSize="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="5,0,0,0"
                                          IsTextScaleFactorEnabled="False" />
                                <TextBlock x:Name="SelectAllButton_Text"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,0"
                                           Visibility="Collapsed"
                                           IsTextScaleFactorEnabled="False" />
                            </Grid>
                        </DropDownButton>

                        <!-- ── CONFIRM SELECTION ──────────────────── -->
                        <Button x:Name="ConfirmButton"
                                Grid.Column="2"
                                Click="ConfirmButton_Click"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                BorderThickness="0"
                                CornerRadius="0,0,0,0"
                                IsTextScaleFactorEnabled="False"
                                ToolTipService.ToolTip="Confirm selection and return to main menu">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <FontIcon Glyph="&#xE8FB;"
                                          FontSize="20"
                                          VerticalAlignment="Center"
                                          IsTextScaleFactorEnabled="False" />
                                <TextBlock Text="Confirm selection"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           IsTextScaleFactorEnabled="False" />
                            </StackPanel>
                        </Button>

                        <!-- ── IMPORT MORE RESOURCE PACKS ────────── -->
                        <Button x:Name="AddPackButton"
                                Grid.Column="4"
                                Click="AddPackButton_Click"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                CornerRadius="0"
                                BorderThickness="0"
                                IsTextScaleFactorEnabled="False"
                                ToolTipService.ToolTip="Allows you to import your resource packs in bulk, supports .zip and .mcpacks formats, multiple packs bundled inside .mcaddon, as well as bulk import from packs inside a folder.">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="12">
                                    <FontIcon Glyph="&#xE896;"
                                              FontSize="20"
                                              VerticalAlignment="Center"
                                              IsTextScaleFactorEnabled="False" />
                                    <TextBlock Text="Import texture packs"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               IsTextScaleFactorEnabled="False" />
                                </StackPanel>
                                <TextBlock x:Name="AddPackDescriptionText"
                                           FontSize="11"
                                           Opacity="0.67"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           IsTextScaleFactorEnabled="False" />
                            </StackPanel>
                        </Button>

                        <!-- ── BEVELLED SPLIT SEAM 1 ────────────────── -->
                        <Grid Grid.Column="0"
                              HorizontalAlignment="Right"
                              Width="3"
                              Margin="0,0,-3,0"
                              IsHitTestVisible="False">
                            <Rectangle Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                            <Border BorderBrush="{ThemeResource FakeSplitButtonDarkBorderColor}"
                                    BorderThickness="3,0,0,0" />
                        </Grid>

                        <Grid Grid.Column="2"
                              HorizontalAlignment="Left"
                              Width="3"
                              Margin="-3,0,0,0"
                              IsHitTestVisible="False">
                            <Rectangle Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                            <Border BorderBrush="{ThemeResource FakeSplitButtonBrightBorderColor}"
                                    BorderThickness="3,0,0,0" />
                        </Grid>
                        <!-- ── BEVELLED SPLIT SEAM 2 ────────────────── -->
                        <Grid Grid.Column="2"
                              HorizontalAlignment="Right"
                              Width="3"
                              Margin="0,0,-3,0"
                              IsHitTestVisible="False">
                            <Rectangle Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                            <Border BorderBrush="{ThemeResource FakeSplitButtonDarkBorderColor}"
                                    BorderThickness="3,0,0,0" />
                        </Grid>

                        <Grid Grid.Column="4"
                              HorizontalAlignment="Left"
                              Width="3"
                              Margin="-3,0,0,0"
                              IsHitTestVisible="False">
                            <Rectangle Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                            <Border BorderBrush="{ThemeResource FakeSplitButtonBrightBorderColor}"
                                    BorderThickness="3,0,0,0" />
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ══ Titlebar Actions ═══════════════════════════════════════════════
             Declared here so the button's x:Name field and Click handler belong to this
             class, but it never renders here: ModuleOverlayTitleBar takes the whole Border
             and shows it in MainWindow's titlebar for as long as this module is open, where
             it reads as a continuation of the buttons already there. That control owns the
             placement and the divider in front of it - this is only what goes in it, sized
             the way MainWindow sizes its own. See ModuleOverlay.TitleBarStrip.
             ═══════════════════════════════════════════════════════════════════ -->
        <Border x:Name="TitleBarActions">
            <Grid Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1">
                <Button x:Name="RefreshButton"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Content="&#xEB05;"
                        Width="40"
                        Height="35"
                        CornerRadius="0"
                        FontSize="16"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="RefreshButton_Click"
                        IsTextScaleFactorEnabled="False"
                        ToolTipService.ToolTip="Rescan the packs folder, measure how much space each pack takes, and refresh the list.">
                </Button>
            </Grid>
        </Border>

    </Grid>
</overlays:ModuleOverlay>
