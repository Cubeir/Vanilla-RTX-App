<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Vanilla_RTX_App.Core.WebImportOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Visibility="Collapsed"
             Opacity="0"
             IsHitTestVisible="False"
             IsTextScaleFactorEnabled="False">

    <!-- Edge-to-edge over the window, save for the 37px titlebar strip above it (matches every
         module window's own TitleBarBackground height) so the system titlebar stays reachable
         while this is open, and the overlay reads as sitting directly beneath it - same bevel,
         same shadow, no gap.

         Background is deliberately SolidBackgroundFillColorBase (a Color resource, wrapped as a
         plain opaque brush) rather than the usual CardBackgroundFillColorDefaultBrush every other
         card in this app uses - that one carries real alpha, designed to look right sitting on
         top of the window's own acrylic backdrop. There is nothing behind this panel but the live
         window content it's supposed to be replacing, so anything less than fully opaque let that
         content bleed straight through and rendered as garbled overlapping text. -->
    <Border x:Name="Panel"
            Background="{ThemeResource SolidBackgroundFillColorBase}"
            Margin="0,37,0,0"
            Translation="0,0,64">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header - one single Auto-height row so the Done button (which fills it top to
                 bottom) grows along with the guide text wrapping to a second line, rather than
                 the two living in separate fixed-height rows. No Grid.Padding here on purpose -
                 the Done button has to reach the true top/right/bottom edges of this block with
                 nothing sitting between it and them, so every other child carries its own margin
                 instead of relying on a shared inset. -->
            <Grid Grid.Row="0"
                  MinHeight="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon x:Name="HeaderIcon"
                          Grid.Column="0"
                          Glyph="&#xE71B;"
                          FontSize="16"
                          Margin="16,2,10,0"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <!-- A real hyperlink to wherever the embedded browser currently is - see
                     HeaderTitleLink_Click. Accent-colored by the control's own default style,
                     matching the icon beside it, so the whole block reads as "this is a link". -->
                <HyperlinkButton x:Name="HeaderTitleLink"
                                 Grid.Column="1"
                                 Padding="0"
                                 VerticalAlignment="Center"
                                 Click="HeaderTitleLink_Click"
                                 ToolTipService.ToolTip="Open this page in your default browser">
                    <TextBlock Text=""
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               IsTextScaleFactorEnabled="False" />
                </HyperlinkButton>

                <Button x:Name="BackButton"
                        Grid.Column="3"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Margin="0,0,2,0"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Click="BackButton_Click"
                        ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>

                <Button x:Name="ForwardButton"
                        Grid.Column="4"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Margin="0,0,2,0"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Click="ForwardButton_Click"
                        ToolTipService.ToolTip="Forward">
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                </Button>

                <Button x:Name="ReloadButton"
                        Grid.Column="5"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="ReloadButton_Click"
                        ToolTipService.ToolTip="Reload">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>

                <!-- Static, caller-supplied instruction ("what does Done mean here") - sandwiched
                     between the nav buttons and the Done button instead of its own row, so it
                     spends the width that used to sit empty rather than its own vertical space.
                     Free to wrap; MinHeight above keeps the row from collapsing to nothing while
                     it does. -->
                <TextBlock x:Name="GuideText"
                           Grid.Column="6"
                           Text=""
                           FontSize="12"
                           Opacity="0.7"
                           Margin="16,10,16,10"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           IsTextScaleFactorEnabled="False" />

                <!-- Accent bevel - same left-edge treatment as MainWindow's Preview toggle, driven
                     by ThemeService.GetBevelColor rather than a static resource so it swaps with
                     light/dark theme instead of always reading as the dark-theme accent. Set
                     imperatively in code-behind (ApplyCloseButtonBevel) because GetBevelColor is a
                     C# color choice, not a ThemeResource binding that re-resolves itself. -->
                <Rectangle Grid.Column="7"
                           Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                <Border x:Name="CloseButtonBevel"
                        Grid.Column="7"
                        BorderThickness="3,0,0,0" />

                <!-- Fills the entire header block, flush against the window's right edge, the
                     titlebar above and the divider below - same "big flush corner button" look as
                     MainWindow's Preview toggle, achieved the same way: the accent bevel above
                     standing in for that button's own fake-split border. -->
                <Button x:Name="CloseButton"
                        Grid.Column="8"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        MinWidth="120"
                        Padding="28,0,28,0"
                        Margin="0"
                        CornerRadius="0"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="Close - anything you downloaded here will be imported automatically">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon x:Name="CloseButtonIcon"
                                  Glyph="&#xE930;"
                                  Margin="0,4,0,0"
                                  FontSize="18" />
                        <TextBlock x:Name="CloseButtonText"
                                   Text="Done"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   IsTextScaleFactorEnabled="False" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="0"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Content - ImportWebView is never Visibility=Collapsed: a WebView2 with no layout
                 bounds can fail its native initialization, so Loading/Error are opaque full-bleed
                 covers stacked on top of it instead of a visibility swap on the WebView2 itself. -->
            <Grid Grid.Row="1">
                <WebView2 x:Name="ImportWebView" />

                <Grid x:Name="LoadingState"
                      Background="{ThemeResource SolidBackgroundFillColorBase}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14">
                        <ProgressRing IsActive="True"
                                      Width="36"
                                      Height="36"
                                      HorizontalAlignment="Center" />
                        <TextBlock x:Name="LoadingText"
                                   Text="Loading..."
                                   Opacity="0.75"
                                   HorizontalAlignment="Center"
                                   IsTextScaleFactorEnabled="False" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ErrorState"
                      Visibility="Collapsed"
                      Background="{ThemeResource SolidBackgroundFillColorBase}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="400"
                                Spacing="12">
                        <FontIcon Glyph="&#xEB5E;"
                                  FontSize="28"
                                  Opacity="0.7"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:Name="ErrorText"
                                   Text="An internet connection is required to load this page."
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Opacity="0.85"
                                   IsTextScaleFactorEnabled="False" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <Button x:Name="GetRuntimeButton"
                                    Content="Get WebView2 Runtime"
                                    Visibility="Collapsed"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="GetRuntimeButton_Click" />
                            <Button Content="Try Again"
                                    Click="RetryButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Downloads shelf - a small floating, opaque card (not the translucent card
                     brush - same reasoning as Panel above) anchored over the page, bottom-right.
                     Collapsed until the first watched-extension download starts, then stays up
                     for the rest of the session so the user can see exactly what came down and
                     whether it finished - this is the entire answer to "how do I know when it's
                     safe to click Done". -->
                <Border x:Name="DownloadsShelf"
                        Visibility="Collapsed"
                        Background="{ThemeResource SolidBackgroundFillColorBase}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,16,16"
                        Width="360"
                        MaxHeight="280"
                        Translation="0,0,48">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Downloads"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Opacity="0.7"
                                   Margin="16,12,16,8"
                                   IsTextScaleFactorEnabled="False" />

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="16,0,16,14">
                            <StackPanel x:Name="DownloadsListPanel"
                                        Spacing="14" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
