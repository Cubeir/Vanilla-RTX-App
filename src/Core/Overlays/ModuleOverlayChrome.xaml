<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Vanilla_RTX_App.Core.Overlays.ModuleOverlayChrome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsTextScaleFactorEnabled="False">

    <!-- The frame every feature module is shown in: the same surface MarkdownOverlay uses,
         starting 36px down so it sits flush under the titlebar's bevelled bottom edge. It is
         only the surface - a module's own markup fills it edge to edge, with nothing of the
         frame's floating over it.

         It exists as XAML rather than as a few lines in ModuleOverlay's constructor for one
         reason: ThemeResource only re-evaluates on a theme change for a brush declared in
         markup. Built in code, the acrylic tint would be whatever the theme was at construction
         and would stay that colour for the overlay's life. -->
    <Border x:Name="Panel"
            Margin="0,36,0,0"
            HorizontalAlignment="Stretch"
            Translation="0,0,64">
        <Border.Background>
            <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                          TintOpacity="0.9"
                          TintLuminosityOpacity="0.9"
                          FallbackColor="{ThemeResource OverlayBackgroundColor}" />
        </Border.Background>
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>

        <!-- The module's own markup, and nothing else. The way out is MainWindow's
             ModuleReturnButton, up in the titlebar beside the caption buttons - see §2i. -->
        <ContentPresenter x:Name="BodyHost"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch" />
    </Border>
</UserControl>
