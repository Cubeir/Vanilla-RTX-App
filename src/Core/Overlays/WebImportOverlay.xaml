<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Vanilla_RTX_App.Core.Overlays.WebImportOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Vanilla_RTX_App.Core.Overlays"
             mc:Ignorable="d"
             Visibility="Collapsed"
             Opacity="0"
             IsHitTestVisible="False"
             IsTextScaleFactorEnabled="False">

    <!-- Edge-to-edge over the window, save for the 37px titlebar strip above it (matches every
         module window's own TitleBarBackground height) so the system titlebar stays reachable
         while this is open, and the overlay reads as sitting directly beneath it - same bevel,
         same shadow, no gap.

         Background is deliberately SolidBackgroundFillColorBase (a Color resource, wrapped as a
         plain opaque brush) rather than the usual CardBackgroundFillColorDefaultBrush every other
         card in this app uses - that one carries real alpha, designed to look right sitting on
         top of the window's own acrylic backdrop. There is nothing behind this panel but the live
         window content it's supposed to be replacing, so anything less than fully opaque let that
         content bleed straight through and rendered as garbled overlapping text. -->
    <Border x:Name="Panel"
            Background="{ThemeResource SolidBackgroundFillColorBase}"
            Margin="0,36,0,0"
            Translation="0,0,64">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Shared chrome - see OverlayHeaderBar. Wired up in code-behind (constructor),
                 not here, since every field it exposes needs to be set imperatively per Show()
                 call anyway. -->
            <local:OverlayHeaderBar x:Name="Header"
                                     Grid.Row="0" />

            <!-- Content - ImportWebView is never Visibility=Collapsed: a WebView2 with no layout
                 bounds can fail its native initialization, so Loading/Error are opaque full-bleed
                 covers stacked on top of it instead of a visibility swap on the WebView2 itself. -->
            <Grid Grid.Row="1">
                <WebView2 x:Name="ImportWebView" />

                <Grid x:Name="LoadingState"
                      Background="{ThemeResource SolidBackgroundFillColorBase}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14">
                        <ProgressRing IsActive="True"
                                      Width="36"
                                      Height="36"
                                      HorizontalAlignment="Center" />
                        <TextBlock x:Name="LoadingText"
                                   Text="Loading..."
                                   Opacity="0.75"
                                   HorizontalAlignment="Center"
                                   IsTextScaleFactorEnabled="False" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ErrorState"
                      Visibility="Collapsed"
                      Background="{ThemeResource SolidBackgroundFillColorBase}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="400"
                                Spacing="12">
                        <FontIcon Glyph="&#xEB5E;"
                                  FontSize="28"
                                  Opacity="0.7"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:Name="ErrorText"
                                   Text="An internet connection is required to load this page."
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Opacity="0.85"
                                   IsTextScaleFactorEnabled="False" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <Button x:Name="GetRuntimeButton"
                                    Content="Get WebView2 Runtime"
                                    Visibility="Collapsed"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="GetRuntimeButton_Click" />
                            <Button x:Name="OpenInBrowserButton"
                                    Content="Open in browser"
                                    Visibility="Collapsed"
                                    Click="OpenInBrowserButton_Click"
                                    ToolTipService.ToolTip="Opens this page in your normal browser and closes this view - download what you need there, then use this window's own Add button to import it." />
                            <Button Content="Try Again"
                                    Click="RetryButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Downloads shelf - a small floating, opaque card (not the translucent card
                     brush - same reasoning as Panel above) anchored over the page, bottom-right.
                     Collapsed until the first watched-extension download starts, then stays up
                     for the rest of the session so the user can see exactly what came down and
                     whether it finished - this is the entire answer to "how do I know when it's
                     safe to click Done". -->
                <Border x:Name="DownloadsShelf"
                        Visibility="Collapsed"
                        Background="{ThemeResource SolidBackgroundFillColorBase}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,16,16"
                        Width="360"
                        MaxHeight="280"
                        Translation="0,0,48">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Downloads"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Opacity="0.7"
                                   Margin="16,12,16,8"
                                   IsTextScaleFactorEnabled="False" />

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="16,0,16,14">
                            <StackPanel x:Name="DownloadsListPanel"
                                        Spacing="14" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
