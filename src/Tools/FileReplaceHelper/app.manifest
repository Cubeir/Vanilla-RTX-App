<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Vanilla_RTX_App.FileReplaceHelper" />

  <!--
    requireAdministrator is the whole point of this executable: Windows shows the standard
    UAC consent prompt the instant this process is launched, without the main (asInvoker) app
    ever needing to elevate itself or restart. This is the pattern the Windows App
    Certification Kit's own UAC test explicitly calls for: "The main process of the app must
    be run as a standard user (asInvoker). Any administrative features must be moved into a
    separate process that runs with administrative privileges." A waiver is only required for
    an app's MAIN/entry-point process needing elevation - this is a secondary helper, invoked
    on demand, never the app's entry point.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 8.1, 10, and 11 compatibility GUIDs. -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}" />
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
