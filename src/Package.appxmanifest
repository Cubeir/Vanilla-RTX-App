<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Cubeir.VanillaRTXApp"
    Publisher="CN=7F2D29F8-D1F9-46A7-9DFB-595D98E11214"
    Version="3.1.2.0" />

  <mp:PhoneIdentity PhoneProductId="14d771a9-af30-450d-a688-01bb3e8bc3bc" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Vanilla RTX App</DisplayName>
    <PublisherDisplayName>Cubeir</PublisherDisplayName>
    <Logo>Assets\icons\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Vanilla RTX App"
        Description="The ultimate companion app for playing Minecraft with RTX at its best! Automatically update Vanilla RTX packages, tune them to your preferences, and launch Minecraft with RTX in one go, plus so much more!"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\icons\Square150x150Logo.png"
        Square44x44Logo="Assets\icons\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\icons\Wide310x150Logo.png"  Square71x71Logo="Assets\icons\SmallTile.png" Square310x310Logo="Assets\icons\LargeTile.png" ShortName="Vanilla RTX App">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo"/>
            <uap:ShowOn Tile="wide310x150Logo"/>
            <uap:ShowOn Tile="square310x310Logo"/>
          </uap:ShowNameOnTiles>
        </uap:DefaultTile >
        <uap:SplashScreen Image="Assets\icons\SplashScreen.png"  BackgroundColor="transparent"/>
        <uap:LockScreen BadgeLogo="Assets\icons\BadgeLogo.png"  Notification="badge"/>
        <uap:InitialRotationPreference>
          <uap:Rotation Preference="landscape"/></uap:InitialRotationPreference>
      </uap:VisualElements>

      <Extensions>
        <!-- Registers the app as an option in "Open with" / double-click for .mcpack files,
             alongside Minecraft's own association - this does not claim the default handler,
             Windows requires the user to set that explicitly. See App.xaml.cs (file
             activation handling) and MainWindow.ImportPackFilesAsync for what happens when
             the app is actually opened this way. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="mcpack">
            <uap:SupportedFileTypes>
              <uap:FileType>.mcpack</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Minecraft Resource Pack</uap:DisplayName>
            <uap:Logo>Assets\icons\import.mcpack.png</uap:Logo>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- Same idea for .rtpack (BetterRTX custom presets) - see
             MainWindow.ImportBetterRTXPresetFilesAsync and
             BetterRTXManagerWindow.ImportPresetFilesHeadlessAsync for what happens when the
             app is opened this way. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="rtpack">
            <uap:SupportedFileTypes>
              <uap:FileType>.rtpack</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Minecraft RTX Shader Pack</uap:DisplayName>
            <uap:Logo>Assets\icons\import.rtpack.png</uap:Logo>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
